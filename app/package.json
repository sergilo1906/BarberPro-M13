{
  "name": "barberpro-m13-app",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && tsc --noEmit",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test:unit": "vitest run tests/unit --maxWorkers=1 --no-file-parallelism",
    "test:e2e": "playwright test"
  },
  "dependencies": {
