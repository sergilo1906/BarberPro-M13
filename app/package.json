    "date-fns": "3.6.0",
    "date-fns-tz": "3.2.0",
    "firebase": "10.14.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@playwright/test": "1.58.2",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "undici": "6.29.1",
    "@grpc/grpc-js": "1.14.7"
  }
}
