---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal title="Pagina no encontrada">
  <section class="max-w-xl mx-auto rounded-lg border border-gray-200 bg-white p-8 text-center space-y-4">
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">404</p>
    <h1 class="text-2xl font-semibold text-gray-900">Esta pagina no existe o ya no esta disponible.</h1>
    <p class="text-sm text-gray-600">
      Vuelve al inicio o entra en la seccion que necesites para continuar con la reserva o la gestion del equipo.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded border px-4 py-2 text-sm hover:bg-gray-50">Ir al inicio</a>
      <a href="/reservar" class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">Reservar cita</a>
    </div>
  </section>
</DisenoPrincipal>
