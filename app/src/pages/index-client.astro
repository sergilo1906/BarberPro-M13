---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";

const opcionesCliente = [
  { titulo: "Reservar cita", descripcion: "Elige servicio, fecha y hora disponible.", ruta: "/reservar", enlace: "Ir a reservar" },
  { titulo: "Mis citas", descripcion: "Consulta tus reservas, estados y cambios recientes.", ruta: "/mis-citas", enlace: "Ver mis citas" },
];
---

<DisenoPrincipal title="Inicio cliente">
  <section class="max-w-3xl mx-auto grid gap-4">
    {
      opcionesCliente.map((opcion) => (
        <div class="bg-white rounded shadow p-4 flex flex-col gap-2">
          <h2 class="text-lg font-semibold">{opcion.titulo}</h2>
          <p class="text-sm text-gray-600">{opcion.descripcion}</p>
          <a href={opcion.ruta} class="inline-block text-center text-sm font-medium border rounded px-3 py-2 hover:bg-gray-50">{opcion.enlace}</a>
        </div>
      ))
    }
  </section>
</DisenoPrincipal>
