---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal noindex title="Panel del equipo">
  <section class="max-w-5xl mx-auto grid gap-4 md:grid-cols-2">
    <div class="bg-white rounded shadow p-4 flex flex-col gap-2">
      <h2 class="text-lg font-semibold">Agenda de hoy</h2>
      <p class="text-sm text-gray-600">Mira las citas del dia.</p>
      <a href="/agenda" class="inline-block text-center text-sm font-medium border rounded px-3 py-2 hover:bg-gray-50">Abrir agenda</a>
    </div>

    <div class="bg-white rounded shadow p-4 flex flex-col gap-2">
      <h2 class="text-lg font-semibold">Resumen</h2>
      <p class="text-sm text-gray-600">Un vistazo rapido del dia.</p>
      <a href="/panel" class="inline-block text-center text-sm font-medium border rounded px-3 py-2 hover:bg-gray-50">Ver panel</a>
    </div>

    <div class="bg-white rounded shadow p-4 flex flex-col gap-2">
      <h2 class="text-lg font-semibold">Horarios</h2>
      <p class="text-sm text-gray-600">Prepara la semana que se vera en reservas.</p>
      <a href="/setup-barber" class="inline-block text-center text-sm font-medium border rounded px-3 py-2 hover:bg-gray-50">Abrir horarios</a>
    </div>

    <div class="hidden bg-white rounded shadow p-4 flex-col gap-2" data-manager-only>
      <h2 class="text-lg font-semibold">Equipo</h2>
      <p class="text-sm text-gray-600">Nombre, email y quien se muestra en reservas.</p>
      <a href="/equipo" class="inline-block text-center text-sm font-medium border rounded px-3 py-2 hover:bg-gray-50">Abrir equipo</a>
    </div>
  </section>
  <script>import "../modulos/navegacion/inicio-equipo";</script>
</DisenoPrincipal>
