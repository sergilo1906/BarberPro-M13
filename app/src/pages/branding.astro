---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal noindex title="Reglas de la agenda">
  <section class="max-w-4xl mx-auto space-y-4">
    <header class="bg-white border rounded-lg p-6 space-y-2">
      <h1 class="text-2xl font-semibold">Reglas de la agenda</h1>
      <p class="text-sm text-gray-600">Aqui ajustas lo basico de la agenda.</p>
    </header>

    <section class="bg-white border rounded-lg p-4 space-y-4">
      <div class="grid gap-3 md:grid-cols-2">
        <label class="text-sm text-gray-700">
          Zona horaria
          <input id="cfg-timezone" class="mt-1 w-full rounded border px-3 py-2 text-sm" placeholder="Europe/Madrid" />
        </label>
        <label class="text-sm text-gray-700">
          Margen minimo para cancelar
          <input id="cfg-cancel-hours" type="number" min="1" step="1" class="mt-1 w-full rounded border px-3 py-2 text-sm" />
        </label>
      </div>

      <label class="text-sm text-gray-700 block">
        Avisos previos (horas, separadas por comas)
        <input id="cfg-reminders" class="mt-1 w-full rounded border px-3 py-2 text-sm" placeholder="24, 2" />
      </label>

      <div class="flex flex-wrap items-center gap-3">
        <button id="cfg-save" class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">Guardar</button>
        <p id="cfg-msg" class="text-sm text-gray-600"></p>
      </div>
    </section>
  </section>
  <script>import "../modulos/administracion/reglas-agenda";</script>
</DisenoPrincipal>
