---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal noindex title="Equipo">
  <section class="max-w-5xl mx-auto space-y-4">
    <header class="bg-white border rounded-lg p-6 space-y-2">
      <h1 class="text-2xl font-semibold">Equipo</h1>
      <p class="text-sm text-gray-600">Solo nombre, email y mostrar en reservas.</p>
    </header>

    <div class="bg-white border rounded-lg p-4 space-y-3">
      <p id="team-msg" class="text-sm text-gray-600"></p>
      <div id="team-list" class="space-y-3"></div>
    </div>
  </section>
  <script>import "../modulos/administracion/equipo";</script>
</DisenoPrincipal>
