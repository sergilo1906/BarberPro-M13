---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal noindex title="Listado de citas">
  <section class="max-w-5xl mx-auto space-y-4">
    <header class="bg-white border rounded-lg p-6 space-y-2">
      <h1 class="text-2xl font-semibold">Listado de citas</h1>
      <p class="text-sm text-gray-600">Consulta un rango de fechas y, si hace falta, descarga el CSV.</p>
    </header>

    <section class="bg-white border rounded-lg p-4 space-y-4">
      <div class="grid gap-3 md:grid-cols-[1fr,1fr,auto]">
        <label class="text-sm text-gray-700">
          Desde
          <input id="export-from" type="date" class="mt-1 w-full rounded border px-3 py-2 text-sm" />
        </label>
        <label class="text-sm text-gray-700">
          Hasta
          <input id="export-to" type="date" class="mt-1 w-full rounded border px-3 py-2 text-sm" />
        </label>
        <div class="flex items-end gap-2">
          <button id="export-preview" class="rounded border px-3 py-2 text-sm hover:bg-gray-50">Ver listado</button>
          <button id="export-download" class="rounded bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700">Descargar CSV</button>
        </div>
      </div>

      <p id="export-msg" class="text-sm text-gray-600"></p>
      <div id="export-preview-list" class="rounded border border-gray-200"></div>
    </section>
  </section>
  <script>import "../modulos/estadisticas/listado-citas";</script>
</DisenoPrincipal>
