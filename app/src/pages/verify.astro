---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal title="Verificar email" noindex>
  <section class="max-w-md bg-white p-4 rounded shadow mx-auto space-y-3 text-sm">
    <h2 class="font-semibold text-lg">Verificar email</h2>
    <p id="verify-msg" role="status" aria-live="polite" class="text-sm text-gray-700">Procesando enlace de verificacion...</p>
    <div class="flex gap-2 pt-2">
      <a href="/perfil" class="px-3 py-2 rounded border hover:bg-gray-50">Ir a perfil</a>
      <a href="/login" class="px-3 py-2 rounded bg-blue-600 text-white hover:bg-blue-700">Iniciar sesion</a>
    </div>
  </section>

  <script>import "../modulos/cuentas/verificar-correo";</script>
</DisenoPrincipal>
