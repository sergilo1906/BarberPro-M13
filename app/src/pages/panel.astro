---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal noindex title="Resumen del dia">
  <section class="max-w-4xl mx-auto space-y-4">
    <div class="bg-white p-4 rounded shadow flex flex-col space-y-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold">Resumen del dia</h2>
          <p class="text-xs text-gray-600">Vista rapida de las citas de hoy.</p>
        </div>

        <label class="text-xs text-gray-600 flex items-center gap-2">
          <span>Periodo</span>
          <select id="stats-period" class="border rounded px-2 py-1 text-sm">
            <option value="hoy" selected>Hoy</option>
          </select>
        </label>
      </div>

      <div class="grid grid-cols-2 gap-3 text-sm">
        <div class="border rounded p-3">
          <div class="text-[10px] uppercase text-gray-500 font-medium">Citas</div>
          <div id="stat-total-bookings" class="text-lg font-semibold">0</div>
        </div>

        <div class="border rounded p-3">
          <div class="text-[10px] uppercase text-gray-500 font-medium">Minutos reservados</div>
          <div id="stat-total-min" class="text-lg font-semibold">0 min</div>
        </div>

        <div class="border rounded p-3">
          <div class="text-[10px] uppercase text-gray-500 font-medium">Horas ocupadas</div>
          <div id="stat-total-hours" class="text-lg font-semibold">0 h</div>
        </div>

        <div class="border rounded p-3">
          <div class="text-[10px] uppercase text-gray-500 font-medium">Servicios mas reservados</div>
          <div id="stat-services" class="text-xs leading-relaxed whitespace-pre-line">
            Sin datos
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white p-4 rounded shadow border border-gray-200">
      <div class="flex items-center justify-between gap-2 mb-3">
        <h3 class="text-sm font-semibold text-gray-900">Proximas citas</h3>
        <a href="/agenda" class="text-xs text-blue-700 underline">Abrir agenda</a>
      </div>
      <p id="panel-msg" class="text-xs text-gray-600 min-h-[1.5rem]"></p>
      <div id="panel-next-list" class="space-y-2 text-sm"></div>
    </div>
  </section>
  <script>import "../modulos/estadisticas/resumen-diario";</script>
</DisenoPrincipal>
