---
import DisenoPrincipal from "../../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal noindex title="Usuarios y roles">
  <section class="max-w-4xl mx-auto space-y-4">
    <header>
      <h1 class="text-xl font-semibold">Usuarios y roles</h1>
      <p class="text-sm text-gray-600">Busca una cuenta por email y cambia su acceso si hace falta.</p>
    </header>

    <form id="search-form" class="bg-white border rounded p-4 space-y-3">
      <label class="text-sm text-gray-700 block">
        Email del usuario
        <input id="email" type="email" required class="mt-1 w-full border rounded px-3 py-2 text-sm" placeholder="usuario@dominio.com" />
      </label>
      <button type="submit" class="rounded bg-blue-600 text-white text-sm px-3 py-2">Buscar usuario</button>
      <p id="msg" class="text-sm text-gray-600"></p>
    </form>

    <div id="results" class="space-y-3"></div>
  </section>
  <script>import "../../modulos/administracion/usuarios";</script>
</DisenoPrincipal>
