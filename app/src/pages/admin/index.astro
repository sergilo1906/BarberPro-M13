---
import DisenoPrincipal from "../../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal noindex title="Administracion">
  <section class="max-w-4xl mx-auto space-y-4">
    <header class="bg-white border rounded p-4 space-y-1">
      <h1 class="text-xl font-semibold">Administracion</h1>
      <p class="text-sm text-gray-600">Lo basico para llevar la barberia: usuarios, equipo y servicios.</p>
    </header>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <a href="/admin/usuarios" class="bg-white border rounded p-4 hover:bg-gray-50">
        <h2 class="font-medium text-sm">Usuarios</h2>
        <p class="text-xs text-gray-600 mt-1">Cambia roles y revisa quien entra como cliente, profesional o responsable.</p>
      </a>

      <a href="/equipo" class="bg-white border rounded p-4 hover:bg-gray-50">
        <h2 class="font-medium text-sm">Equipo</h2>
        <p class="text-xs text-gray-600 mt-1">Revisa quien sale en reservas y deja el equipo al dia.</p>
      </a>

      <a href="/servicios" class="bg-white border rounded p-4 hover:bg-gray-50">
        <h2 class="font-medium text-sm">Servicios</h2>
        <p class="text-xs text-gray-600 mt-1">Edita nombre, duracion, precio y si se sigue mostrando.</p>
      </a>
    </div>
  </section>
</DisenoPrincipal>
