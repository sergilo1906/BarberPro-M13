---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal title="Horarios" noindex>
  <section class="max-w-xl mx-auto bg-white border border-gray-200 rounded-lg p-6 space-y-4" data-estado="no-disponible" data-fase-pendiente="7">
    <h1 class="text-xl font-semibold text-gray-900">Horarios</h1>
    <p role="status" class="text-sm text-gray-600">Esta seccion todavia no esta disponible.</p>
    <p class="text-sm text-gray-600">No se han habilitado operaciones ni acceso a datos privados. Puedes volver al inicio o consultar la ayuda.</p>
    <div class="flex flex-wrap gap-3 text-sm">
      <a href="/" class="rounded border px-3 py-2 hover:bg-gray-50">Ir al inicio</a>
      <a href="/ayuda" class="rounded bg-blue-600 px-3 py-2 text-white hover:bg-blue-700">Ayuda</a>
    </div>
  </section>
</DisenoPrincipal>
