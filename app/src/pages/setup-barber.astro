---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";

const nombresDias = [
  "Domingo",
  "Lunes",
  "Martes",
  "Miercoles",
  "Jueves",
  "Viernes",
  "Sabado",
];
---

<DisenoPrincipal title="Horarios">
  <section class="bg-white shadow rounded-md w-full max-w-5xl border border-gray-200 p-6 space-y-5 mx-auto">
    <header class="space-y-1">
      <h1 class="text-xl font-semibold text-gray-800">Horarios</h1>
      <p class="text-sm text-gray-600 max-w-2xl">
        Prepara la semana que se mostrara en reservas.
      </p>
    </header>

    <div class="rounded-md border border-blue-100 bg-blue-50 p-4 space-y-3">
      <div id="setup-barber-wrap" class="hidden space-y-1">
        <label class="block text-xs text-blue-900 font-semibold" for="setup-barber-select">Profesional</label>
        <select id="setup-barber-select" class="w-full rounded border border-blue-200 bg-white px-3 py-2 text-sm text-gray-800">
          <option value="">Cargando profesionales...</option>
        </select>
        <p id="setup-barber-help" class="text-xs text-blue-800"></p>
      </div>
    </div>

    <div class="bg-gray-50 border border-gray-200 rounded-md p-4 space-y-3">
      <div class="grid gap-4 md:grid-cols-[1fr,auto]">
        <div class="space-y-1">
          <label class="block text-xs text-gray-600 font-semibold" for="week-date">Semana</label>
          <input id="week-date" type="date" class="w-full border rounded px-2 py-2 text-sm" />
          <p class="text-[11px] text-gray-500">La semana va de lunes a domingo.</p>
        </div>

        <div class="flex items-end gap-2">
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <input id="week-published" type="checkbox" class="h-4 w-4 rounded border-gray-300" />
            Mostrar en reservas
          </label>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button id="week-prev" type="button" class="rounded border border-gray-300 px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-white">Semana anterior</button>
        <button id="week-next" type="button" class="rounded border border-gray-300 px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-white">Semana siguiente</button>
        <p id="week-current-label" class="text-xs text-gray-600"></p>
      </div>

      <button id="copy-week" type="button" class="text-sm text-blue-600 hover:text-blue-800 underline">Copiar semana pasada</button>
    </div>

      <div class="overflow-x-auto border border-gray-200 rounded">
        <table class="w-full text-sm text-gray-800">
          <thead class="bg-gray-50 text-gray-700 text-xs uppercase border-b border-gray-200">
            <tr>
              <th class="text-left p-3 font-medium">Dia</th>
              <th class="text-center p-3 font-medium">Disponible</th>
              <th class="text-left p-3 font-medium">Inicio 1</th>
              <th class="text-left p-3 font-medium">Fin 1</th>
              <th class="text-left p-3 font-medium">Inicio 2</th>
              <th class="text-left p-3 font-medium">Fin 2</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-200">
            {
              nombresDias.map((nombre, indice) => (
                <tr class="bg-white" data-day={indice}>
                  <td class="p-3">{nombre}</td>

                  <td class="p-3 text-center">
                    <input id={`work-${indice}`} type="checkbox" class="rounded border-gray-300" />
                  </td>

                  <td class="p-3">
                    <input id={`start-${indice}`} type="time" step="60" class="w-full rounded border border-gray-300 px-2 py-1 text-sm bg-gray-50 disabled:text-gray-400 disabled:bg-gray-100" />
                  </td>

                  <td class="p-3">
                    <input id={`end-${indice}`} type="time" step="60" class="w-full rounded border border-gray-300 px-2 py-1 text-sm bg-gray-50 disabled:text-gray-400 disabled:bg-gray-100" />
                  </td>

                  <td class="p-3">
                    <input id={`start2-${indice}`} type="time" step="60" class="w-full rounded border border-gray-300 px-2 py-1 text-sm bg-gray-50 disabled:text-gray-400 disabled:bg-gray-100" />
                  </td>

                  <td class="p-3">
                    <input id={`end2-${indice}`} type="time" step="60" class="w-full rounded border border-gray-300 px-2 py-1 text-sm bg-gray-50 disabled:text-gray-400 disabled:bg-gray-100" />
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Intervalo entre huecos (min)</label>
      <input id="slot-minutes" type="number" min="5" step="5" placeholder="30" class="w-full rounded border border-gray-300 px-3 py-2 text-sm" />
      <p class="mt-1 text-[11px] text-gray-500">Marca cada cuanto se generan los huecos.</p>
    </div>

    <div class="flex items-center gap-3">
      <button id="save-config" class="rounded bg-blue-600 text-white text-sm font-medium px-4 py-2 hover:bg-blue-700">Guardar semana</button>

      <p id="config-error" class="hidden text-sm font-medium text-red-600">No se pudo guardar.</p>
      <p id="config-ok" class="hidden text-sm font-medium text-green-600">Semana guardada.</p>
    </div>
  </section>

  <script>import "../modulos/profesionales/editar-horario";</script>
</DisenoPrincipal>
