---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal noindex title="Resumen">
  <section class="max-w-5xl mx-auto space-y-4">
    <header class="bg-white border rounded-lg p-6 space-y-2">
      <h1 class="text-2xl font-semibold">Resumen</h1>
      <p class="text-sm text-gray-600">Citas, servicios y reparto por profesional.</p>
    </header>

    <section class="bg-white border rounded-lg p-4 space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <label class="text-sm text-gray-700">
          Periodo
          <select id="kpi-range" class="mt-1 rounded border px-3 py-2 text-sm">
            <option value="day">Hoy</option>
            <option value="week">Ultimos 7 dias</option>
            <option value="month">Mes actual</option>
          </select>
        </label>
        <button id="kpi-refresh" class="rounded border px-3 py-2 text-sm hover:bg-gray-50">Recargar</button>
      </div>

      <p id="kpi-msg" class="text-sm text-gray-600"></p>
      <div id="kpi-cards" class="grid gap-3 md:grid-cols-4"></div>
      <div class="grid gap-4 lg:grid-cols-2">
        <div class="rounded border border-gray-200 p-4">
          <h2 class="text-sm font-semibold text-gray-900">Servicios mas usados</h2>
          <div id="kpi-services" class="mt-3 space-y-2 text-sm"></div>
        </div>
        <div class="rounded border border-gray-200 p-4">
          <h2 class="text-sm font-semibold text-gray-900">Citas por profesional</h2>
          <div id="kpi-staff" class="mt-3 space-y-2 text-sm"></div>
        </div>
      </div>
    </section>
  </section>
  <script>import "../modulos/estadisticas/indicadores";</script>
</DisenoPrincipal>
