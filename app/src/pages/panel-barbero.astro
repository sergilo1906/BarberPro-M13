---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal title="Panel del profesional">
  <section class="max-w-4xl mx-auto space-y-4">
    <div class="bg-white p-4 rounded shadow border border-gray-200">
      <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
        <div>
          <h2 class="font-semibold text-lg">Panel del profesional</h2>
          <p class="text-xs text-gray-600 leading-tight">Resumen rapido del dia.</p>
        </div>

        <div class="text-xs text-gray-700 flex items-center gap-2">
          <label for="stats-range" class="text-[11px] text-gray-500">Periodo</label>
          <select id="stats-range" class="border rounded px-2 py-1 text-xs">
            <option value="day">Hoy</option>
            <option value="week">Ultimos 7 dias</option>
            <option value="month">Mes actual</option>
          </select>
        </div>
      </div>

      <div id="stats-cards" class="grid grid-cols-2 gap-4 text-sm"></div>

      <p id="stats-msg" class="text-xs text-gray-600 min-h-[1.5rem] leading-tight mt-4"></p>
    </div>

    <div class="bg-white p-4 rounded shadow border border-gray-200">
      <div class="flex items-center justify-between gap-2 mb-3">
        <h3 class="text-sm font-semibold text-gray-900">Proximas citas</h3>
        <a href="/agenda" class="text-xs text-blue-700 underline">Ver agenda</a>
      </div>
      <div id="pro-next-list" class="space-y-2 text-sm"></div>
    </div>
  </section>

  <script>import "../modulos/profesionales/panel-profesional";</script>
</DisenoPrincipal>
