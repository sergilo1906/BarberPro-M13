---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal noindex title="Resumen de horarios">
  <section class="max-w-5xl mx-auto space-y-4">
    <header class="bg-white border rounded-lg p-6 space-y-2">
      <h1 class="text-2xl font-semibold">Resumen de horarios</h1>
      <p class="text-sm text-gray-600">Vista rapida para saber quien tiene la semana lista y quien necesita repasar horarios.</p>
    </header>

    <section class="bg-white border rounded-lg p-4 space-y-4">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold">Semana actual</h2>
          <p class="text-sm text-gray-600">Comprueba quien ya aparece en reservas y entra directo a editar su semana.</p>
        </div>
        <a href="/setup-barber" class="rounded border px-3 py-2 text-sm hover:bg-gray-50">Abrir horarios</a>
      </div>
      <p id="hours-msg" class="text-sm text-gray-600"></p>
      <div id="hours-list" class="grid gap-3"></div>
    </section>
  </section>
  <script>import "../modulos/administracion/resumen-horarios";</script>
</DisenoPrincipal>
