# Plantilla ficticia. Sin este archivo local, las páginas públicas funcionan igualmente.
# Copiar a .env.local solo para configurar emuladores; no usar credenciales reales.
PUBLIC_USE_FIREBASE_EMULATORS=0
PUBLIC_USE_FUNCTIONS_EMULATOR=0
PUBLIC_FIREBASE_API_KEY=demo-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
PUBLIC_FIREBASE_PROJECT_ID=demo-barberpro-m13
PUBLIC_FIREBASE_STORAGE_BUCKET=demo-barberpro-m13.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
PUBLIC_FIREBASE_APP_ID=1:123456789:web:demo
PUBLIC_APP_URL=http://localhost:4321
