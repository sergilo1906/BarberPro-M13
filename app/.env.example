# LOCAL: copiar a .env.local. Datos ficticios, nunca credenciales administrativas.
PUBLIC_FIREBASE_MODE=local
PUBLIC_USE_FIREBASE_EMULATORS=1
PUBLIC_USE_FUNCTIONS_EMULATOR=1
PUBLIC_FIREBASE_API_KEY=demo-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
PUBLIC_FIREBASE_PROJECT_ID=demo-barberpro-m13
PUBLIC_FIREBASE_APP_ID=1:123456789:web:demo
PUBLIC_APP_URL=http://localhost:4321
# WEB: modo=web, ambas flags=0, configuracion publica de TU app Firebase,
# authDomain=TU_PROJECT_ID.firebaseapp.com y PUBLIC_APP_URL=https://TU_SITE.web.app

