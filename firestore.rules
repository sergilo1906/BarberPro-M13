rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function tieneSesion() { return request.auth != null; }
    function rolToken() { return request.auth.token.get('role', 'client'); }
    function versionToken() { return request.auth.token.get('roleVersion', 0); }
    function rolVigente() {
      let perfil = /databases/$(database)/documents/users/$(request.auth.uid);
      return rolToken() in ['client', 'admin'] && (
        (!exists(perfil) && rolToken() == 'client' && versionToken() == 0) ||
        (exists(perfil) && get(perfil).data.role == rolToken() && get(perfil).data.get('roleVersion', 0) == versionToken())
      );
    }
    function operativo() { return tieneSesion() && request.auth.token.email_verified == true && rolVigente(); }
    function administrador() { return operativo() && rolToken() == 'admin'; }
    function contactoValido() {
      return request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30;
    }
    match /users/{uid} {
      allow get: if tieneSesion() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create: if tieneSesion() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','phone','email','role','roleVersion','createdAt','updatedAt'])
        && contactoValido() && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'client' && rolToken() == 'client'
        && request.resource.data.roleVersion == 0 && versionToken() == 0
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if tieneSesion() && request.auth.uid == uid && contactoValido()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }
    match /services/{id} { allow read: if operativo(); allow write: if false; }
    match /config/{id} { allow read: if operativo(); allow write: if false; }
    match /closedDays/{id} { allow read: if administrador(); allow write: if false; }
    match /bookings/{id} { allow read: if operativo() && (administrador() || resource.data.userId == request.auth.uid); allow write: if false; }
    match /{documento=**} { allow read, write: if false; }
  }
}

